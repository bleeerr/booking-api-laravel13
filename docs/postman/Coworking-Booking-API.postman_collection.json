        "description": "Импортируйте коллекцию, задайте admin_password и user_password в Variables (пароли выводятся при первом запуске сидеров), затем выполните Demo walkthrough по порядку. Все запросы с телом используют JSON. Пароли безопасно экранируются pre-request скриптом; токены и ID сохраняются автоматически.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Demo walkthrough — run in order",
            "item": [
                {
                    "name": "01 Login Admin",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "login"
                            ]
                        },
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": {{admin_password_json}}\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Тело передаётся как JSON. Pre-request скрипт коллекции экранирует специальные символы пароля из переменной admin_password."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "  pm.collectionVariables.set(\"admin_token\", pm.response.json().data.token);",
                                    "}"
                                ]
                            }
                        }
                    ]
