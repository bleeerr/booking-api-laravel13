    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Encode raw passwords as JSON string literals before Postman substitutes them into request bodies.",
                    "// Avoid wrapping {{admin_password_json}} and {{user_password_json}} in extra quotes.",
                    "for (const role of [\"admin\", \"user\"]) {",
                    "  const password = pm.variables.get(`${role}_password`);",
                    "  pm.variables.set(`${role}_password_json`, JSON.stringify(password ?? \"\"));",
                    "}"
                ]
            }
        }
    ]
